{
  "name": "kitty-vs-everything",
  "version": "3.72.1",
  "description": "Kitty Vs Everything — the cat defends the galaxy. `npm run build` produces a single self-contained `Kitty Vs Everything <version>.html` in Z:\\AI-GAMES\\Builds\\",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "serve": "python -m http.server 8000",
    "validate": "node ../tools/validate.mjs",
    "check": "node ../tools/check.mjs",
    "check:full": "node ../tools/check.mjs --full",
    "harness": "node ../tools/harness.mjs",
    "lan": "node net/server.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
